<?xml version="1.0" encoding="UTF-8"?><?xml-stylesheet type="text/xsl" href="{{ getUrl('sitemap.xsl') }}"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set criteria = [
    ['published','=','on'],
    ['in_menu','=','on'],
    'and',
    [
        [
            ['type','!=','acf'],
            ['link_type','=','page']
        ],
        'or',
        [
            ['type','=','page']
        ]
    ]
] %}

{%- set slug = app.request.get('_route_params').slug %}
{%- if slug == 'sitemap' %}
	{% set pages = b().findAllBy([ criteria, [['parent', 'is', 'null'], 'or', ['parent', '=', 'null']] ]).fetch() %}
	{% for item in pages %}
		{%- if item.slug not in ['/', 'home', 'accueil'] -%}
<sitemap>
	<loc>{{ getHref(item) }}-sitemap.xml</loc>
	<lastmod>{{ item.updated_at }}</lastmod>
</sitemap>
		{%- endif -%}
	{%- endfor -%}
{% else %}
	{% set slug = slug|replace({'-sitemap':''}) %}
	{% set parent = b().findOneBy([['type', '=', 'page'], ['slug', '=', slug]]).fetch() %}
	{% set pages = b().findAllBy(criteria).orderBy({'updated_at':'desc'}).fetch() %}
	{% set items = buildTree(pages, 'raw', null, [], null, parent.id) ?: [] %}

	{% set itemsIDs = [parent.id] %}
	{% for item in items %}
		{% set itemsIDs = itemsIDs|merge([item.id]) %}
	{%- endfor -%}
	{% set items = items|merge( b().findAllBy([['parent', 'in', itemsIDs], ['type', 'not in', ['page', 'acf']]]).orderBy({'updated_at':'desc'}).fetch() ?? [] ) %}

	{% for item in items %}
		<sitemap>
			<loc>{{ getHref(item) }}</loc>
			<lastmod>{{ item.updated_at }}</lastmod>
		</sitemap>
	{%- else -%}
		<sitemap>
			<loc>{{ getHref(parent) }}</loc>
			<lastmod>{{ parent.updated_at }}</lastmod>
		</sitemap>
	{%- endfor -%}
{% endif %}

</sitemapindex>
<!-- XML Sitemap generated by Silvère Dovoui' SWAGG CMS -->